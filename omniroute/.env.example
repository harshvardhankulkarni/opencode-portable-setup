# OmniRoute .env — sanitized copy of node_modules/omniroute/.env.example
# Full upstream contract is in upstream-.env.example (129 KB)
# Copy to ~/.omniroute/.env and fill required secrets, then: omniroute

# Required secrets — generate per machine:
# openssl rand -base64 48  -> JWT_SECRET
# openssl rand -hex 32     -> API_KEY_SECRET, STORAGE_ENCRYPTION_KEY
STORAGE_ENCRYPTION_KEY=${STORAGE_ENCRYPTION_KEY}
JWT_SECRET=${JWT_SECRET}
API_KEY_SECRET=${API_KEY_SECRET}
INITIAL_PASSWORD=CHANGEME

# Network
PORT=20128
# DATA_DIR=~/.omniroute

# See upstream-.env.example for 50+ optional vars (REDIS_URL, API_PORT, DASHBOARD_PORT, etc.)
