  "agent": {
    "build": {
      "model": "google/gemini-2.5-flash",
      "temperature": 0.2,
      "top_p": 0.9,
      "prompt": "You are a senior software engineer. Write clean, tested, maintainable code.",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "glob": true,
        "grep": true,
        "list": true,
        "todo": true,
        "task": true,
        "lsp": true
      }
    },
    "plan": {
      "model": "google/gemini-2.5-flash",
      "temperature": 0.1,
      "prompt": "You are a technical architect. Create detailed, actionable plans.",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "list": true,
        "todo": true,
        "bash": true
      }
    },
    "general": {
      "model": "google/gemini-2.5-flash",
      "temperature": 0.3,
      "prompt": "You are a helpful AI assistant. Be concise and accurate.",
      "tools": {
        "read": true,
        "write": true,
        "bash": true,
        "websearch": true,
        "webfetch": true
      }
    }
  },
  "permission": {
    "read": "allow",
    "write": "ask",
    "edit": "ask",
    "bash": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "ask",
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask"
  },
  "formatter": true,
  "lsp": true,
  "mcp": {
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "C:/Users/PilzIndia/.local/bin/codebase-memory-mcp.exe"
      ]
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "enabled": true,
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users/PilzIndia"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "officecli": {
      "type": "local",
      "command": [
        "C:/Users/PilzIndia/bin/officecli.exe",
        "mcp"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp"
      ]
    },
    "twos-io": {
      "type": "local",
      "command": [
        "npx",
        "@2sio/mcp"
      ],
      "env": {
        "TWOS_TRIAL": "1"
      }
    },
    "correctover": {
      "type": "local",
      "command": [
        "npx",
        "correctover-mcp-server"
      ]
    }
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "tail_turns": 10,
    "preserve_recent_tokens": 50000,
    "reserved": 10000
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "attachment": {
    "max_size": 10485760,
    "max_images": 20
  },
  "server": {
    "port": 3000,
    "hostname": "127.0.0.1",
    "mdns": false,
    "mdns_domain": "opencode.local"
  },
  "experimental": {
    "disable_paste_summary": false,
    "batch_tool": true,
    "openTelemetry": true
  }
}