  "shell": "bash",
  "logLevel": "INFO",
  "model": "google/gemini-2.5-flash",
  "small_model": "google/gemini-2.5-flash",
  "default_agent": "build",
  "subagent_depth": 1,
  "username": "Harsh",
  "autoupdate": "notify",
  "share": "manual",
  "snapshot": true,
  "plugin": [
    "@dietrichgebert/ponytail",
    "oh-my-opencode-slim",
