# =====================================================================
# opencode-portable-setup — unified .env template
# Copy to .env and fill. Never commit .env (gitignored).
# =====================================================================

# 1) FreeLLMAPI — central gateway (ALL clients -> :31415)
#    npx freellmapi setup-claude --url http://127.0.0.1:31415
FREELLMAPI_API_KEY=your-freellmapi-key-here
ANTHROPIC_BASE_URL=http://127.0.0.1:31415
ANTHROPIC_AUTH_TOKEN=your-anthropic-token-here
# Opencode reads FREELLMAPI_API_KEY via {env:FREELLMAPI_API_KEY}

# 2) OmniRoute — router :20128 (npm i -g omniroute@3.8.49)
OMNIROUTE_API_KEY=your-omniroute-key-here
# also needs ~/.omniroute/.env — see omniroute/.env.example
STORAGE_ENCRYPTION_KEY=
JWT_SECRET=
API_KEY_SECRET=
INITIAL_PASSWORD=CHANGEME

# 3) Core MCP
GITHUB_TOKEN=your-github-token-here
FIRECRAWL_API_KEY=your-firecrawl-key-here

# 4) Optional MCP (uncomment)
# VERCEL_TOKEN=your-vercel-token
# LINEAR_API_KEY=your-linear-key
# SENTRY_AUTH_TOKEN=your-sentry-token
# E2B_API_KEY=your-e2b-key
# SUPABASE_ACCESS_TOKEN=your-supabase-token
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# BROWSERBASE_API_KEY=your-browserbase-key
# BROWSERBASE_PROJECT_ID=your-project-id
# SKYVERN_API_KEY=your-skyvern-key
# TWOS_TRIAL=1
